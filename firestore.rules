rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userUid() {
      return request.auth.uid;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function adminByEmail() {
      return isSignedIn()
        && userEmail() != null
        && exists(/databases/$(database)/documents/admins/$(userEmail()));
    }

    // Optional future collection if you decide to store admin docs by uid.
    function adminByUid() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminsByUid/$(userUid()));
    }

    function isAdmin() {
      return isAdminRole() || adminByEmail() || adminByUid();
    }

    function isSuperAdmin() {
      return isSignedIn()
        && (
          userRole() == 'superadmin'
          || (
            adminByEmail()
            && get(/databases/$(database)/documents/admins/$(userEmail())).data.role == 'superadmin'
          )
        );
    }

    function userProfileExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(userUid()));
    }

    function userRole() {
      return userProfileExists()
        ? get(/databases/$(database)/documents/users/$(userUid())).data.role
        : null;
    }

    function isAdminRole() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isClientRole() {
      return isSignedIn() && userRole() == 'client';
    }

    function isClientOrAdmin() {
      return isAdminRole() || isClientRole();
    }

    function hasOwnedUuid(uuidValue) {
      return isSignedIn()
        && isClientOrAdmin()
        && uuidValue != null
        && uuidValue == userUid();
    }

    function canAccessUuidDoc(uuidValue) {
      return isSignedIn()
        && isClientOrAdmin()
        && (isAdminRole() || hasOwnedUuid(uuidValue));
    }

    function canAccessUuidOrEmailDoc(uuidValue, emailValue) {
      return isSignedIn()
        && isClientOrAdmin()
        && (
          isAdminRole()
          || hasOwnedUuid(uuidValue)
          || (emailValue != null && emailValue == userEmail())
        );
    }

    function canAccessLinkedInquiry(inquiryIdValue) {
      return isSignedIn()
        && isClientOrAdmin()
        && (
          isAdminRole()
          || (
            inquiryIdValue is string
            && inquiryIdValue != ''
            && exists(/databases/$(database)/documents/inquiries/$(inquiryIdValue))
            && (
              get(/databases/$(database)/documents/inquiries/$(inquiryIdValue)).data.uuid == userUid()
              || get(/databases/$(database)/documents/inquiries/$(inquiryIdValue)).data.email == userEmail()
            )
          )
        );
    }

    function canAccessLinkedInquiryDoc(inquiryIdValue, uuidValue, emailValue) {
      return isSignedIn()
        && isClientOrAdmin()
        && (
          isAdminRole()
          || hasOwnedUuid(uuidValue)
          || (emailValue != null && emailValue == userEmail())
          || canAccessLinkedInquiry(inquiryIdValue)
        );
    }

    function isServiceReportReceiptEmail() {
      let data = request.resource.data;
      let projectPath = /databases/$(database)/documents/projects/$(data.projectId);
      let reportPath = /databases/$(database)/documents/projects/$(data.projectId)/serviceReports/$(data.serviceReportId);
      let recipient = data.to[0];
      let adminPath = /databases/$(database)/documents/admins/$(recipient);
      return isSignedIn()
        && data.keys().hasOnly([
          'to', 'clientName', 'recipientName', 'recipientType', 'projectId',
          'serviceReportId', 'createdAt', 'message'
        ])
        && data.to is list
        && data.to.size() == 1
        && data.clientName is string
        && data.recipientName is string
        && data.recipientType == 'admin'
        && data.projectId is string
        && data.serviceReportId is string
        && data.createdAt is timestamp
        && data.message is map
        && data.message.keys().hasOnly(['subject', 'text', 'html'])
        && data.message.subject is string
        && data.message.subject == 'Client confirmed service report receipt: ' + data.projectId
        && data.message.text is string
        && data.message.text.size() <= 2000
        && data.message.html is string
        && data.message.html.size() <= 10000
        && exists(projectPath)
        && exists(reportPath)
        && canAccessLinkedInquiryDoc(
          get(projectPath).data.iid,
          get(projectPath).data.uuid,
          get(projectPath).data.email
        )
        && get(reportPath).data.clientAccessEnabled != false
        && get(reportPath).data.status == 'received'
        && get(reportPath).data.adminNotificationQueued != true
        && (
          recipient == get(reportPath).data.uploadedByEmail
          || recipient == get(reportPath).data.uploadedBy
        )
        && getAfter(reportPath).data.status == 'received'
        && getAfter(reportPath).data.receivedBy == userEmail()
        && getAfter(reportPath).data.adminNotificationQueued == true
        && exists(adminPath)
        && get(adminPath).data.status != 'deactivated'
        && get(adminPath).data.role in ['admin', 'superadmin']
        && data.recipientName ==
          (get(reportPath).data.uploadedByFirstName is string
            ? get(reportPath).data.uploadedByFirstName
            : 'Admin');
    }

    // Ownership helper during migration (uid-first, email fallback).
    function ownsByUidOrEmail(uidValue, emailValue) {
      return isSignedIn() && (
        (uidValue != null && uidValue == userUid()) ||
        (emailValue != null && userEmail() != null && emailValue == userEmail())
      );
    }

    function isAuthorizedMessageUnsend() {
      return ownsByUidOrEmail(resource.data.senderUid, resource.data.senderId)
        || (isSuperAdmin() && resource.data.senderRole == 'admin');
    }

    // ----- Admin and account collections -----

    match /admins/{docId} {
      allow get: if isAdmin() || (isSignedIn() && userEmail() != null && docId == userEmail());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && uid == userUid());
      allow create, update: if isAdmin() || (isSignedIn() && uid == userUid());
      allow delete: if isAdmin();
    }

    match /roles/{roleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /catalogSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin()
        || isServiceReportReceiptEmail()
        || (
          isSignedIn()
          && request.resource.data.keys().hasOnly(['to', 'message', 'inquiryId'])
          && request.resource.data.inquiryId is string
          && request.resource.data.to is list
          && request.resource.data.to.size() >= 1
          && request.resource.data.to.size() <= 5
          && request.resource.data.message is map
          && request.resource.data.message.keys().hasOnly(['subject', 'text', 'html'])
          && request.resource.data.message.subject is string
          && request.resource.data.message.subject.size() > 0
          && request.resource.data.message.subject.size() <= 200
          && request.resource.data.message.text is string
          && request.resource.data.message.html is string
          && (
            (
              request.resource.data.to.size() == 1
              && request.resource.data.to[0] == userEmail()
            )
            || (
              request.resource.data.to[0] in ['mdayon1@up.edu.ph', 'madayon1@up.edu.ph', 'sequencing.pgc.upvisayas@up.edu.ph', 'bioinfo.pgc.upvisayas@up.edu.ph']
              && (request.resource.data.to.size() < 2 || request.resource.data.to[1] in ['mdayon1@up.edu.ph', 'madayon1@up.edu.ph', 'sequencing.pgc.upvisayas@up.edu.ph', 'bioinfo.pgc.upvisayas@up.edu.ph'])
              && (request.resource.data.to.size() < 3 || request.resource.data.to[2] in ['mdayon1@up.edu.ph', 'madayon1@up.edu.ph', 'sequencing.pgc.upvisayas@up.edu.ph', 'bioinfo.pgc.upvisayas@up.edu.ph'])
              && (request.resource.data.to.size() < 4 || request.resource.data.to[3] in ['mdayon1@up.edu.ph', 'madayon1@up.edu.ph', 'sequencing.pgc.upvisayas@up.edu.ph', 'bioinfo.pgc.upvisayas@up.edu.ph'])
              && (request.resource.data.to.size() < 5 || request.resource.data.to[4] in ['mdayon1@up.edu.ph', 'madayon1@up.edu.ph', 'sequencing.pgc.upvisayas@up.edu.ph', 'bioinfo.pgc.upvisayas@up.edu.ph'])
            )
          )
        );
    }

    match /clientAnnouncements/{announcementId} {
      allow get, list: if isAdmin()
        || (
          isSignedIn()
          && userEmail() in [
            'dayonmerlitojr@gmail.com',
            'carmjavier@gmail.com'
          ]
          && resource.data.targetEmail == 'dayonmerlitojr@gmail.com'
        );
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'isActive', 'targetEmail', 'createdAt',
          'createdBy', 'updatedAt', 'updatedBy', 'startAt', 'endAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.isActive is bool
        && request.resource.data.targetEmail == 'dayonmerlitojr@gmail.com'
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == userEmail()
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy == userEmail()
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt > request.resource.data.startAt;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'isActive', 'targetEmail', 'createdAt',
          'createdBy', 'updatedAt', 'updatedBy', 'startAt', 'endAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.isActive is bool
        && request.resource.data.targetEmail == 'dayonmerlitojr@gmail.com'
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == userEmail()
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt > request.resource.data.startAt
        && (
          !('createdAt' in resource.data)
          || request.resource.data.createdAt == resource.data.createdAt
        )
        && (
          !('createdBy' in resource.data)
          || request.resource.data.createdBy == resource.data.createdBy
        );
      allow delete: if isAdmin();
    }

    match /clientAnnouncementSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /officeCalendar/{eventId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && request.resource.data.createdBy == userEmail()
        && (
          !('createdByUid' in request.resource.data)
          || request.resource.data.createdByUid == userUid()
        );
      allow update, delete: if isAdmin();
    }

    // ----- Core owner-scoped collections -----

    match /inquiries/{inquiryId} {
      allow create: if isSignedIn()
        && isClientOrAdmin()
        && (
          (isAdminRole() && request.resource.data.uuid is string)
          || hasOwnedUuid(request.resource.data.uuid)
        );

      allow read: if canAccessUuidOrEmailDoc(resource.data.uuid, resource.data.email);

      allow update, delete: if isSignedIn()
        && isClientOrAdmin()
        && (
          isAdminRole()
          || (
            hasOwnedUuid(resource.data.uuid)
            && hasOwnedUuid(request.resource.data.uuid)
            && request.resource.data.uuid == resource.data.uuid
          )
        );
    }

    match /clients/{cid} {
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.email == userEmail()
          && (
            !('ownerUid' in request.resource.data)
            || request.resource.data.ownerUid == userUid()
          )
        );

      allow read: if isAdmin()
        || ownsByUidOrEmail(resource.data.ownerUid, resource.data.email);

      allow update, delete: if isAdmin()
        || (
          ownsByUidOrEmail(resource.data.ownerUid, resource.data.email)
          && request.resource.data.email == resource.data.email
          && (
            !('ownerUid' in request.resource.data)
            || request.resource.data.ownerUid == resource.data.ownerUid
            || request.resource.data.ownerUid == userUid()
          )
        );
    }

    match /clientRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.requestedBy == userEmail()
        && (
          !('requestedByUid' in request.resource.data)
          || request.resource.data.requestedByUid == userUid()
        );

      allow read: if isAdmin()
        || ownsByUidOrEmail(resource.data.requestedByUid, resource.data.requestedBy);

      allow update, delete: if isAdmin()
        || (
          ownsByUidOrEmail(resource.data.requestedByUid, resource.data.requestedBy)
          && request.resource.data.requestedBy == resource.data.requestedBy
          && (
            !('requestedByUid' in request.resource.data)
            || request.resource.data.requestedByUid == resource.data.requestedByUid
            || request.resource.data.requestedByUid == userUid()
          )
        );
    }

    match /projectRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.requestedBy == userEmail()
        && (
          !('requestedByUid' in request.resource.data)
          || request.resource.data.requestedByUid == userUid()
        );

      allow read: if isAdmin()
        || ownsByUidOrEmail(resource.data.requestedByUid, resource.data.requestedBy);

      allow update, delete: if isAdmin()
        || (
          ownsByUidOrEmail(resource.data.requestedByUid, resource.data.requestedBy)
          && request.resource.data.requestedBy == resource.data.requestedBy
          && (
            !('requestedByUid' in request.resource.data)
            || request.resource.data.requestedByUid == resource.data.requestedByUid
            || request.resource.data.requestedByUid == userUid()
          )
        );
    }

    match /memberApprovals/{approvalId} {
      allow create: if isSignedIn()
        && request.resource.data.submittedBy == userEmail()
        && (
          !('submittedByUid' in request.resource.data)
          || request.resource.data.submittedByUid == userUid()
        );

      allow read: if isAdmin()
        || ownsByUidOrEmail(resource.data.submittedByUid, resource.data.submittedBy);

      allow update, delete: if isAdmin()
        || (
          ownsByUidOrEmail(resource.data.submittedByUid, resource.data.submittedBy)
          && request.resource.data.submittedBy == resource.data.submittedBy
          && (
            !('submittedByUid' in request.resource.data)
            || request.resource.data.submittedByUid == resource.data.submittedByUid
            || request.resource.data.submittedByUid == userUid()
          )
        );
    }

    match /quotationThreads/{threadId} {
      allow create: if isSignedIn()
        && (
          isAdmin()
          || (
            request.resource.data.clientEmail == userEmail()
            && (
              !('clientUid' in request.resource.data)
              || request.resource.data.clientUid == userUid()
            )
          )
        );

      allow read: if isAdmin()
        || ownsByUidOrEmail(resource.data.clientUid, resource.data.clientEmail);

      allow update, delete: if isAdmin()
        || (
          ownsByUidOrEmail(resource.data.clientUid, resource.data.clientEmail)
          && request.resource.data.clientEmail == resource.data.clientEmail
          && (
            !('clientUid' in request.resource.data)
            || request.resource.data.clientUid == resource.data.clientUid
            || request.resource.data.clientUid == userUid()
          )
        );
    }

    match /threadMessages/{messageId} {
      allow create: if isSignedIn()
        && (
          (
            request.resource.data.senderId == userEmail()
            && (
              !('senderUid' in request.resource.data)
              || request.resource.data.senderUid == userUid()
            )
          )
          || (
            'senderUid' in request.resource.data
            && request.resource.data.senderUid == userUid()
          )
          || isAdmin()
        );

      allow read: if isAdmin()
        || (
          exists(/databases/$(database)/documents/quotationThreads/$(resource.data.threadId))
          && ownsByUidOrEmail(
            get(/databases/$(database)/documents/quotationThreads/$(resource.data.threadId)).data.clientUid,
            get(/databases/$(database)/documents/quotationThreads/$(resource.data.threadId)).data.clientEmail
          )
        );

      allow update: if (
          isAdmin()
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['unsent', 'content', 'attachments'])
            || (
              isAuthorizedMessageUnsend()
              && resource.data.unsent != true
              && request.resource.data.unsent == true
              && request.resource.data.content == ''
              && request.resource.data.attachments is list
              && request.resource.data.attachments.size() == 0
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unsent', 'content', 'attachments'])
            )
          )
        )
        || (
          ownsByUidOrEmail(resource.data.senderUid, resource.data.senderId)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['unsent', 'content', 'attachments'])
            || (
              resource.data.unsent != true
              && request.resource.data.unsent == true
              && request.resource.data.content == ''
              && request.resource.data.attachments is list
              && request.resource.data.attachments.size() == 0
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unsent', 'content', 'attachments'])
            )
          )
        )
        || (
          isSuperAdmin()
          && resource.data.senderRole == 'admin'
          && resource.data.unsent != true
          && request.resource.data.unsent == true
          && request.resource.data.content == ''
          && request.resource.data.attachments is list
          && request.resource.data.attachments.size() == 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unsent', 'content', 'attachments'])
        );

      allow delete: if isAdmin()
        || ownsByUidOrEmail(resource.data.senderUid, resource.data.senderId);
    }

    match /adminMentionNotifications/{notificationId} {
      allow create: if isAdmin()
        && request.resource.data.senderEmail == userEmail()
        && request.resource.data.recipientEmail is string
        && exists(/databases/$(database)/documents/admins/$(request.resource.data.recipientEmail))
        && exists(/databases/$(database)/documents/threadMessages/$(request.resource.data.messageId))
        && get(/databases/$(database)/documents/threadMessages/$(request.resource.data.messageId)).data.senderId == userEmail()
        && get(/databases/$(database)/documents/threadMessages/$(request.resource.data.messageId)).data.mentionedAdminEmails is list
        && request.resource.data.recipientEmail in get(/databases/$(database)/documents/threadMessages/$(request.resource.data.messageId)).data.mentionedAdminEmails;

      allow read: if isAdmin()
        && resource.data.recipientEmail == userEmail();

      allow update: if isAdmin()
        && resource.data.recipientEmail == userEmail()
        && request.resource.data.recipientEmail == resource.data.recipientEmail
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read is bool;

      allow delete: if false;
    }

    match /quotations/{quotationId} {
      allow create: if isSignedIn()
        && isClientOrAdmin()
        && (
          (isAdminRole() && request.resource.data.uuid is string)
          || hasOwnedUuid(request.resource.data.uuid)
        );

      allow read: if canAccessUuidOrEmailDoc(resource.data.uuid, resource.data.email);

      allow update, delete: if isSignedIn()
        && isClientOrAdmin()
        && (
          isAdminRole()
          || (
            hasOwnedUuid(resource.data.uuid)
            && hasOwnedUuid(request.resource.data.uuid)
            && request.resource.data.uuid == resource.data.uuid
          )
        );
    }

    match /projects/{projectId} {
      allow create: if isSignedIn()
        && isClientOrAdmin()
        && (
          (isAdminRole() && request.resource.data.uuid is string)
          || hasOwnedUuid(request.resource.data.uuid)
        );

      allow read: if canAccessLinkedInquiryDoc(resource.data.iid, resource.data.uuid, resource.data.email);

      allow update, delete: if isSignedIn()
        && isClientOrAdmin()
        && (
          isAdminRole()
          || (
            hasOwnedUuid(resource.data.uuid)
            && hasOwnedUuid(request.resource.data.uuid)
            && request.resource.data.uuid == resource.data.uuid
          )
        );

      match /officialReceipts/{receiptId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uploadedBy == userEmail();
        allow update, delete: if isAdmin()
          || resource.data.uploadedBy == userEmail();
      }

      match /serviceReports/{reportId} {
        allow read: if isSignedIn();
        allow create, delete: if isAdmin();
        allow update: if isAdmin()
          || (
            isSignedIn()
            && canAccessLinkedInquiryDoc(
              get(/databases/$(database)/documents/projects/$(projectId)).data.iid,
              get(/databases/$(database)/documents/projects/$(projectId)).data.uuid,
              get(/databases/$(database)/documents/projects/$(projectId)).data.email
            )
            && resource.data.clientAccessEnabled != false
            && (
              (
                resource.data.status != 'received'
                && request.resource.data.status == 'received'
                && request.resource.data.receivedBy == userEmail()
                && request.resource.data.receivedByName is string
                && request.resource.data.receivedAt is timestamp
                && request.resource.data.adminNotificationQueued == false
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'status', 'receivedBy', 'receivedByName', 'receivedAt',
                  'adminNotificationQueued'
                ])
              )
              || (
                resource.data.status == 'received'
                && resource.data.receivedBy == userEmail()
                && resource.data.adminNotificationQueued != true
                && request.resource.data.adminNotificationQueued == true
                && (
                  resource.data.uploadedByEmail is string
                  || resource.data.uploadedBy is string
                )
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['adminNotificationQueued'])
              )
            )
          );
      }

      match /serviceReportRequirementHistory/{historyId} {
        function createsValidBypassHistory() {
          let reportPath = /databases/$(database)/documents/projects/$(projectId)/serviceReports/$(request.resource.data.serviceReportId);
          return request.resource.data.keys().hasOnly([
              'serviceReportId', 'fileName', 'skippedByName',
              'skippedByEmail', 'createdAt'
            ])
            && request.resource.data.serviceReportId is string
            && request.resource.data.fileName is string
            && request.resource.data.skippedByName is string
            && request.resource.data.skippedByEmail == userEmail()
            && request.resource.data.createdAt is timestamp
            && existsAfter(reportPath)
            && getAfter(reportPath).data.skipChargeSlipRequirement == true
            && getAfter(reportPath).data.uploadedByEmail == userEmail()
            && getAfter(reportPath).data.uploadedByName
              == request.resource.data.skippedByName
            && getAfter(reportPath).data.fileName == request.resource.data.fileName;
        }

        allow read: if isSuperAdmin();
        allow create: if isAdmin() && createsValidBypassHistory();
        allow update, delete: if false;
      }
    }

    match /sampleForms/{formId} {
      allow create: if isSignedIn()
        && request.resource.data.submittedByEmail == userEmail()
        && (
          !('submittedByUid' in request.resource.data)
          || request.resource.data.submittedByUid == userUid()
        );

      allow read: if isAdmin()
        || ownsByUidOrEmail(resource.data.submittedByUid, resource.data.submittedByEmail);

      allow update, delete: if isAdmin()
        || (
          ownsByUidOrEmail(resource.data.submittedByUid, resource.data.submittedByEmail)
          && request.resource.data.submittedByEmail == resource.data.submittedByEmail
          && (
            !('submittedByUid' in request.resource.data)
            || request.resource.data.submittedByUid == resource.data.submittedByUid
            || request.resource.data.submittedByUid == userUid()
          )
        );
    }

    match /sampleFormsPDF/{formId} {
      allow read: if isAdmin()
        || (
          exists(/databases/$(database)/documents/sampleForms/$(formId))
          && ownsByUidOrEmail(
            get(/databases/$(database)/documents/sampleForms/$(formId)).data.submittedByUid,
            get(/databases/$(database)/documents/sampleForms/$(formId)).data.submittedByEmail
          )
        );

      allow create, update, delete: if isAdmin()
        || (
          exists(/databases/$(database)/documents/sampleForms/$(formId))
          && ownsByUidOrEmail(
            get(/databases/$(database)/documents/sampleForms/$(formId)).data.submittedByUid,
            get(/databases/$(database)/documents/sampleForms/$(formId)).data.submittedByEmail
          )
        );
    }

    match /clientFormSubmissions/{submissionId} {
      allow create: if isSignedIn()
        && request.resource.data.uploadedBy == userEmail()
        && (
          !('uploadedByUid' in request.resource.data)
          || request.resource.data.uploadedByUid == userUid()
        );

      allow read: if isAdmin()
        || ownsByUidOrEmail(resource.data.uploadedByUid, resource.data.uploadedBy);

      allow update, delete: if isAdmin()
        || ownsByUidOrEmail(resource.data.uploadedByUid, resource.data.uploadedBy);
    }

    match /clientNotifications/{notificationId} {
      allow create: if isAdmin();

      allow read: if isAdmin()
        || ownsByUidOrEmail(resource.data.recipientUid, resource.data.recipientEmail);

      allow update, delete: if isAdmin()
        || ownsByUidOrEmail(resource.data.recipientUid, resource.data.recipientEmail);
    }

    match /chargeSlips/{chargeSlipId} {
      allow create: if isSignedIn()
        && isClientOrAdmin()
        && (
          (isAdminRole() && request.resource.data.uuid is string)
          || hasOwnedUuid(request.resource.data.uuid)
        );

      allow read: if canAccessLinkedInquiryDoc(resource.data.inquiryId, resource.data.uuid, resource.data.email);

      allow update, delete: if isSignedIn()
        && isClientOrAdmin()
        && (
          isAdminRole()
          || (
            hasOwnedUuid(resource.data.uuid)
            && hasOwnedUuid(request.resource.data.uuid)
            && request.resource.data.uuid == resource.data.uuid
          )
        );
    }

    match /chargeSlips/{chargeSlipId}/statusHistory/{historyId} {
      allow read: if isSuperAdmin();
      allow create: if isAdmin()
        && request.resource.data.changedByEmail == userEmail();
      allow update, delete: if false;
    }

    match /receipts/{receiptId} {
      allow create: if isSignedIn()
        && request.resource.data.uploadedBy == userEmail();

      allow read: if isSignedIn();

      allow update, delete: if isAdmin()
        || resource.data.uploadedBy == userEmail();
    }

    match /adminChannels/{channelId} {
      allow read, write: if isAdmin();
    }

    match /adminMessages/{messageId} {
      allow read, write: if isAdmin();
    }

    match /presence/{presenceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /clientConformes/{conformeId} {
      allow create: if isSignedIn()
        && request.resource.data.data.createdBy == userEmail()
        && (
          !('createdByUid' in request.resource.data.data)
          || request.resource.data.data.createdByUid == userUid()
        );

      allow read: if isAdmin()
        || ownsByUidOrEmail(resource.data.data.createdByUid, resource.data.data.createdBy);

      allow update: if isAdmin();
      allow delete: if false;
    }

    // ----- Default deny -----

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

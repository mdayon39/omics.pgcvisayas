rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userUid() {
      return request.auth.uid;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function adminByEmail() {
      return isSignedIn()
        && userEmail() != null
        && exists(/databases/$(database)/documents/admins/$(userEmail()));
    }

    // Optional future collection if you decide to store admin docs by uid.
    function adminByUid() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminsByUid/$(userUid()));
    }

    function isAdmin() {
      return isAdminRole() || adminByEmail() || adminByUid();
    }

    function isAdminAccount() {
      return isSignedIn()
        && (
          (
            userEmail() != null
            && exists(/databases/$(database)/documents/admins/$(userEmail()))
            && get(/databases/$(database)/documents/admins/$(userEmail())).data.status != 'deactivated'
          )
          || adminByUid()
        );
    }

    function adminRole() {
      return userEmail() != null
        && exists(/databases/$(database)/documents/admins/$(userEmail()))
        ? get(/databases/$(database)/documents/admins/$(userEmail())).data.role
        : get(/databases/$(database)/documents/users/$(userUid())).data.role;
    }

    function hasAdminPermission(moduleName, actionName) {
      return isAdminAccount()
        && (
          adminRole() == 'superadmin'
          || get(/databases/$(database)/documents/rolePermissions/$(adminRole())).data[moduleName][actionName] == true
        );
    }

    function hasAnyAdminPermission() {
      return hasAdminPermission('dashboard', 'view')
        || hasAdminPermission('inquiries', 'view')
        || hasAdminPermission('projects', 'view')
        || hasAdminPermission('clients', 'view')
        || hasAdminPermission('quotations', 'view')
        || hasAdminPermission('chargeSlips', 'view')
        || hasAdminPermission('sampleForms', 'view')
        || hasAdminPermission('configurations', 'view')
        || hasAdminPermission('officeCalendar', 'view')
        || hasAdminPermission('memberApprovals', 'view')
        || hasAdminPermission('usersPermissions', 'view')
        || hasAdminPermission('activityLogs', 'view');
    }

    function userProfileExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(userUid()));
    }

    function userRole() {
      return userProfileExists()
        ? get(/databases/$(database)/documents/users/$(userUid())).data.role
        : null;
    }

    function isAdminRole() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isClientRole() {
      return isSignedIn() && userRole() == 'client';
    }

    function isClientOrAdmin() {
      return isAdminAccount() || isClientRole();
    }

    function hasOwnedUuid(uuidValue) {
      return isSignedIn()
        && isClientOrAdmin()
        && uuidValue != null
        && uuidValue == userUid();
    }

    function canAccessUuidDoc(uuidValue) {
      return isSignedIn()
        && isClientOrAdmin()
        && hasOwnedUuid(uuidValue);
    }

    function canAccessUuidOrEmailDoc(uuidValue, emailValue) {
      return isSignedIn()
        && isClientOrAdmin()
        && (
          hasOwnedUuid(uuidValue)
          || (emailValue != null && emailValue == userEmail())
        );
    }

    function canAccessLinkedInquiry(inquiryIdValue) {
      return isSignedIn()
        && isClientOrAdmin()
        && (
          inquiryIdValue is string
          && inquiryIdValue != ''
          && exists(/databases/$(database)/documents/inquiries/$(inquiryIdValue))
          && (
            get(/databases/$(database)/documents/inquiries/$(inquiryIdValue)).data.uuid == userUid()
            || get(/databases/$(database)/documents/inquiries/$(inquiryIdValue)).data.email == userEmail()
          )
        );
    }

    function canAccessLinkedInquiryDoc(inquiryIdValue, uuidValue, emailValue) {
      return isSignedIn()
        && isClientOrAdmin()
        && (
          hasOwnedUuid(uuidValue)
          || (emailValue != null && emailValue == userEmail())
          || canAccessLinkedInquiry(inquiryIdValue)
        );
    }

    // Ownership helper during migration (uid-first, email fallback).
    function ownsByUidOrEmail(uidValue, emailValue) {
      return isSignedIn() && (
        (uidValue != null && uidValue == userUid()) ||
        (emailValue != null && userEmail() != null && emailValue == userEmail())
      );
    }

    // ----- Admin and account collections -----

    match /admins/{docId} {
      allow get: if hasAdminPermission('usersPermissions', 'view') || (isSignedIn() && userEmail() != null && docId == userEmail());
      allow list: if hasAdminPermission('usersPermissions', 'view');
      allow create: if hasAdminPermission('usersPermissions', 'create');
      allow update: if hasAdminPermission('usersPermissions', 'edit');
      allow delete: if hasAdminPermission('usersPermissions', 'delete');
    }

    match /users/{uid} {
      allow read: if hasAdminPermission('usersPermissions', 'view') || (isSignedIn() && uid == userUid());
      allow create: if hasAdminPermission('usersPermissions', 'create') || (isSignedIn() && uid == userUid());
      allow update: if hasAdminPermission('usersPermissions', 'edit') || (isSignedIn() && uid == userUid());
      allow delete: if hasAdminPermission('usersPermissions', 'delete');
    }

    match /roles/{roleId} {
      allow read: if hasAdminPermission('roleManagement', 'view');
      allow create: if hasAdminPermission('roleManagement', 'create');
      allow update: if hasAdminPermission('roleManagement', 'edit');
      allow delete: if hasAdminPermission('roleManagement', 'delete');
    }

    match /rolePermissions/{roleId} {
      allow read: if isAdminAccount();
      allow create: if hasAdminPermission('roleManagement', 'create');
      allow update: if hasAdminPermission('roleManagement', 'edit');
      allow delete: if hasAdminPermission('roleManagement', 'delete');
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow create: if hasAdminPermission('configurations', 'create');
      allow update: if hasAdminPermission('configurations', 'edit');
      allow delete: if hasAdminPermission('configurations', 'delete');
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create: if hasAdminPermission('serviceCatalog', 'create');
      allow update: if hasAdminPermission('serviceCatalog', 'edit');
      allow delete: if hasAdminPermission('serviceCatalog', 'delete');
    }

    match /catalogSettings/{docId} {
      allow read: if isSignedIn();
      allow create: if hasAdminPermission('catalogSettings', 'create');
      allow update: if hasAdminPermission('catalogSettings', 'edit');
      allow delete: if hasAdminPermission('catalogSettings', 'delete');
    }

    match /activityLogs/{logId} {
      allow read: if hasAdminPermission('activityLogs', 'view');
      allow create: if isSignedIn();
      allow update: if hasAdminPermission('activityLogs', 'edit');
      allow delete: if hasAdminPermission('activityLogs', 'delete');
    }

    match /mail/{mailId} {
      allow read: if hasAnyAdminPermission();
      allow update: if hasAnyAdminPermission();
      allow delete: if hasAnyAdminPermission();
      allow create: if hasAnyAdminPermission()
        || (
          isSignedIn()
          && request.resource.data.keys().hasOnly(['to', 'message', 'inquiryId'])
          && request.resource.data.inquiryId is string
          && request.resource.data.to is list
          && request.resource.data.to.size() >= 1
          && request.resource.data.to.size() <= 5
          && request.resource.data.message is map
          && request.resource.data.message.keys().hasOnly(['subject', 'text', 'html'])
          && request.resource.data.message.subject is string
          && request.resource.data.message.subject.size() > 0
          && request.resource.data.message.subject.size() <= 200
          && request.resource.data.message.text is string
          && request.resource.data.message.html is string
          && (
            (
              request.resource.data.to.size() == 1
              && request.resource.data.to[0] == userEmail()
            )
            || (
              request.resource.data.to[0] in ['mdayon1@up.edu.ph', 'madayon1@up.edu.ph', 'sequencing.pgc.upvisayas@up.edu.ph', 'bioinfo.pgc.upvisayas@up.edu.ph']
              && (request.resource.data.to.size() < 2 || request.resource.data.to[1] in ['mdayon1@up.edu.ph', 'madayon1@up.edu.ph', 'sequencing.pgc.upvisayas@up.edu.ph', 'bioinfo.pgc.upvisayas@up.edu.ph'])
              && (request.resource.data.to.size() < 3 || request.resource.data.to[2] in ['mdayon1@up.edu.ph', 'madayon1@up.edu.ph', 'sequencing.pgc.upvisayas@up.edu.ph', 'bioinfo.pgc.upvisayas@up.edu.ph'])
              && (request.resource.data.to.size() < 4 || request.resource.data.to[3] in ['mdayon1@up.edu.ph', 'madayon1@up.edu.ph', 'sequencing.pgc.upvisayas@up.edu.ph', 'bioinfo.pgc.upvisayas@up.edu.ph'])
              && (request.resource.data.to.size() < 5 || request.resource.data.to[4] in ['mdayon1@up.edu.ph', 'madayon1@up.edu.ph', 'sequencing.pgc.upvisayas@up.edu.ph', 'bioinfo.pgc.upvisayas@up.edu.ph'])
            )
          )
        );
    }

    match /officeCalendar/{eventId} {
      allow read: if isSignedIn();
      allow create: if hasAdminPermission('officeCalendar', 'create')
        && request.resource.data.createdBy == userEmail()
        && (
          !('createdByUid' in request.resource.data)
          || request.resource.data.createdByUid == userUid()
        );
      allow update: if hasAdminPermission('officeCalendar', 'edit');
      allow delete: if hasAdminPermission('officeCalendar', 'delete');
    }

    // ----- Core owner-scoped collections -----

    match /inquiries/{inquiryId} {
      allow create: if isSignedIn()
        && isClientOrAdmin()
        && (
          (hasAdminPermission('inquiries', 'create') && request.resource.data.uuid is string)
          || hasOwnedUuid(request.resource.data.uuid)
        );

      allow read: if hasAdminPermission('inquiries', 'view')
        || canAccessUuidOrEmailDoc(resource.data.uuid, resource.data.email);

      allow update: if isSignedIn()
        && isClientOrAdmin()
        && (
          hasAdminPermission('inquiries', 'edit')
          || (
            hasOwnedUuid(resource.data.uuid)
            && hasOwnedUuid(request.resource.data.uuid)
            && request.resource.data.uuid == resource.data.uuid
          )
        );
      allow delete: if isSignedIn()
        && isClientOrAdmin()
        && (
          hasAdminPermission('inquiries', 'delete')
          || (
            hasOwnedUuid(resource.data.uuid)
            && hasOwnedUuid(request.resource.data.uuid)
            && request.resource.data.uuid == resource.data.uuid
          )
        );
    }

    match /clients/{cid} {
      allow create: if hasAdminPermission('clients', 'create')
        || (
          isSignedIn()
          && request.resource.data.email == userEmail()
          && (
            !('ownerUid' in request.resource.data)
            || request.resource.data.ownerUid == userUid()
          )
        );

      allow read: if hasAdminPermission('clients', 'view')
        || ownsByUidOrEmail(resource.data.ownerUid, resource.data.email);

      allow update: if hasAdminPermission('clients', 'edit')
        || (
          ownsByUidOrEmail(resource.data.ownerUid, resource.data.email)
          && request.resource.data.email == resource.data.email
          && (
            !('ownerUid' in request.resource.data)
            || request.resource.data.ownerUid == resource.data.ownerUid
            || request.resource.data.ownerUid == userUid()
          )
        );
      allow delete: if hasAdminPermission('clients', 'delete');
    }

    match /clientRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.requestedBy == userEmail()
        && (
          !('requestedByUid' in request.resource.data)
          || request.resource.data.requestedByUid == userUid()
        );

      allow create: if hasAdminPermission('memberApprovals', 'create')
        || (
          isSignedIn()
          && request.resource.data.requestedBy == userEmail()
          && (
            !('requestedByUid' in request.resource.data)
            || request.resource.data.requestedByUid == userUid()
          )
        );

      allow read: if hasAdminPermission('memberApprovals', 'view')
        || ownsByUidOrEmail(resource.data.requestedByUid, resource.data.requestedBy);

      allow update: if hasAdminPermission('memberApprovals', 'edit')
        || ownsByUidOrEmail(resource.data.requestedByUid, resource.data.requestedBy);
      allow delete: if hasAdminPermission('memberApprovals', 'delete')
        || (
          ownsByUidOrEmail(resource.data.requestedByUid, resource.data.requestedBy)
          && request.resource.data.requestedBy == resource.data.requestedBy
          && (
            !('requestedByUid' in request.resource.data)
            || request.resource.data.requestedByUid == resource.data.requestedByUid
            || request.resource.data.requestedByUid == userUid()
          )
        );
    }

    match /projectRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.requestedBy == userEmail()
        && (
          !('requestedByUid' in request.resource.data)
          || request.resource.data.requestedByUid == userUid()
        );

      allow create: if hasAdminPermission('memberApprovals', 'create')
        || (
          isSignedIn()
          && request.resource.data.requestedBy == userEmail()
          && (
            !('requestedByUid' in request.resource.data)
            || request.resource.data.requestedByUid == userUid()
          )
        );

      allow read: if hasAdminPermission('memberApprovals', 'view')
        || ownsByUidOrEmail(resource.data.requestedByUid, resource.data.requestedBy);

      allow update: if hasAdminPermission('memberApprovals', 'edit')
        || ownsByUidOrEmail(resource.data.requestedByUid, resource.data.requestedBy);
      allow delete: if hasAdminPermission('memberApprovals', 'delete')
        || (
          ownsByUidOrEmail(resource.data.requestedByUid, resource.data.requestedBy)
          && request.resource.data.requestedBy == resource.data.requestedBy
          && (
            !('requestedByUid' in request.resource.data)
            || request.resource.data.requestedByUid == resource.data.requestedByUid
            || request.resource.data.requestedByUid == userUid()
          )
        );
    }

    match /memberApprovals/{approvalId} {
      allow create: if isSignedIn()
        && request.resource.data.submittedBy == userEmail()
        && (
          !('submittedByUid' in request.resource.data)
          || request.resource.data.submittedByUid == userUid()
        );

      allow read: if hasAdminPermission('memberApprovals', 'view')
        || ownsByUidOrEmail(resource.data.submittedByUid, resource.data.submittedBy);

      allow update: if hasAdminPermission('memberApprovals', 'edit')
        || (
          ownsByUidOrEmail(resource.data.submittedByUid, resource.data.submittedBy)
          && request.resource.data.submittedBy == resource.data.submittedBy
          && (
            !('submittedByUid' in request.resource.data)
            || request.resource.data.submittedByUid == resource.data.submittedByUid
            || request.resource.data.submittedByUid == userUid()
          )
        );
    }

    match /quotationThreads/{threadId} {
      allow create: if isSignedIn()
        && (
          hasAdminPermission('inquiries', 'create')
          || (
            request.resource.data.clientEmail == userEmail()
            && (
              !('clientUid' in request.resource.data)
              || request.resource.data.clientUid == userUid()
            )
          )
        );

      allow read: if hasAdminPermission('inquiries', 'view')
        || ownsByUidOrEmail(resource.data.clientUid, resource.data.clientEmail);

      allow update: if hasAdminPermission('inquiries', 'edit')
        || (
          ownsByUidOrEmail(resource.data.clientUid, resource.data.clientEmail)
          && request.resource.data.clientEmail == resource.data.clientEmail
          && (
            !('clientUid' in request.resource.data)
            || request.resource.data.clientUid == resource.data.clientUid
            || request.resource.data.clientUid == userUid()
          )
        );
      allow delete: if hasAdminPermission('inquiries', 'delete')
        || ownsByUidOrEmail(resource.data.clientUid, resource.data.clientEmail);
    }

    match /threadMessages/{messageId} {
      allow create: if isSignedIn()
        && (
          (
            request.resource.data.senderId == userEmail()
            && (
              !('senderUid' in request.resource.data)
              || request.resource.data.senderUid == userUid()
            )
          )
          || (
            'senderUid' in request.resource.data
            && request.resource.data.senderUid == userUid()
          )
          || hasAdminPermission('inquiries', 'edit')
        );

      allow read: if hasAdminPermission('inquiries', 'view')
        || (
          exists(/databases/$(database)/documents/quotationThreads/$(resource.data.threadId))
          && ownsByUidOrEmail(
            get(/databases/$(database)/documents/quotationThreads/$(resource.data.threadId)).data.clientUid,
            get(/databases/$(database)/documents/quotationThreads/$(resource.data.threadId)).data.clientEmail
          )
        );

      allow update: if hasAdminPermission('inquiries', 'edit')
        || ownsByUidOrEmail(resource.data.senderUid, resource.data.senderId);
      allow delete: if hasAdminPermission('inquiries', 'delete')
        || ownsByUidOrEmail(resource.data.senderUid, resource.data.senderId);
    }

    match /quotations/{quotationId} {
      allow create: if isSignedIn()
        && isClientOrAdmin()
        && (
          (hasAdminPermission('quotations', 'create') && request.resource.data.uuid is string)
          || hasOwnedUuid(request.resource.data.uuid)
        );

      allow read: if hasAdminPermission('quotations', 'view')
        || (isSignedIn() && resource.data.uuid == userUid())
        || canAccessUuidOrEmailDoc(resource.data.uuid, resource.data.email);

      allow update: if isSignedIn()
        && isClientOrAdmin()
        && (
          hasAdminPermission('quotations', 'edit')
          || (
            hasOwnedUuid(resource.data.uuid)
            && hasOwnedUuid(request.resource.data.uuid)
            && request.resource.data.uuid == resource.data.uuid
          )
        );
      allow delete: if hasAdminPermission('quotations', 'delete')
        || hasOwnedUuid(resource.data.uuid);
    }

    match /projects/{projectId} {
      allow create: if isSignedIn()
        && isClientOrAdmin()
        && (
          (hasAdminPermission('projects', 'create') && request.resource.data.uuid is string)
          || hasOwnedUuid(request.resource.data.uuid)
        );

      allow read: if hasAdminPermission('projects', 'view')
        || canAccessLinkedInquiryDoc(resource.data.iid, resource.data.uuid, resource.data.email);

      allow update: if isSignedIn()
        && isClientOrAdmin()
        && (
          hasAdminPermission('projects', 'edit')
          || (
            hasOwnedUuid(resource.data.uuid)
            && hasOwnedUuid(request.resource.data.uuid)
            && request.resource.data.uuid == resource.data.uuid
          )
        );
      allow delete: if hasAdminPermission('projects', 'delete')
        || hasOwnedUuid(resource.data.uuid);

      match /officialReceipts/{receiptId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uploadedBy == userEmail();
        allow update: if hasAdminPermission('officialReceipts', 'edit')
          || resource.data.uploadedBy == userEmail();
        allow delete: if hasAdminPermission('officialReceipts', 'delete')
          || resource.data.uploadedBy == userEmail();
      }

      match /serviceReports/{reportId} {
        allow read: if isSignedIn();
        allow create: if hasAdminPermission('sampleForms', 'create');
        allow update: if hasAdminPermission('sampleForms', 'edit');
        allow delete: if hasAdminPermission('sampleForms', 'delete');
      }
    }

    match /sampleForms/{formId} {
      allow create: if isSignedIn()
        && request.resource.data.submittedByEmail == userEmail()
        && (
          !('submittedByUid' in request.resource.data)
          || request.resource.data.submittedByUid == userUid()
        );

      allow read: if hasAdminPermission('sampleForms', 'view')
        || ownsByUidOrEmail(resource.data.submittedByUid, resource.data.submittedByEmail);

      allow update: if hasAdminPermission('sampleForms', 'edit')
        || (
          ownsByUidOrEmail(resource.data.submittedByUid, resource.data.submittedByEmail)
          && request.resource.data.submittedByEmail == resource.data.submittedByEmail
          && (
            !('submittedByUid' in request.resource.data)
            || request.resource.data.submittedByUid == resource.data.submittedByUid
            || request.resource.data.submittedByUid == userUid()
          )
        );
      allow delete: if hasAdminPermission('sampleForms', 'delete')
        || ownsByUidOrEmail(resource.data.submittedByUid, resource.data.submittedByEmail);
    }

    match /sampleFormsPDF/{formId} {
      allow read: if hasAdminPermission('sampleForms', 'view')
        || (
          exists(/databases/$(database)/documents/sampleForms/$(formId))
          && ownsByUidOrEmail(
            get(/databases/$(database)/documents/sampleForms/$(formId)).data.submittedByUid,
            get(/databases/$(database)/documents/sampleForms/$(formId)).data.submittedByEmail
          )
        );

      allow create: if hasAdminPermission('sampleForms', 'create')
        || (
          exists(/databases/$(database)/documents/sampleForms/$(formId))
          && ownsByUidOrEmail(
            get(/databases/$(database)/documents/sampleForms/$(formId)).data.submittedByUid,
            get(/databases/$(database)/documents/sampleForms/$(formId)).data.submittedByEmail
          )
        );
      allow update: if hasAdminPermission('sampleForms', 'edit')
        || (
          exists(/databases/$(database)/documents/sampleForms/$(formId))
          && ownsByUidOrEmail(
            get(/databases/$(database)/documents/sampleForms/$(formId)).data.submittedByUid,
            get(/databases/$(database)/documents/sampleForms/$(formId)).data.submittedByEmail
          )
        );
      allow delete: if hasAdminPermission('sampleForms', 'delete')
        || (
          exists(/databases/$(database)/documents/sampleForms/$(formId))
          && ownsByUidOrEmail(
            get(/databases/$(database)/documents/sampleForms/$(formId)).data.submittedByUid,
            get(/databases/$(database)/documents/sampleForms/$(formId)).data.submittedByEmail
          )
        );
    }

    match /clientFormSubmissions/{submissionId} {
      allow create: if isSignedIn()
        && request.resource.data.uploadedBy == userEmail()
        && (
          !('uploadedByUid' in request.resource.data)
          || request.resource.data.uploadedByUid == userUid()
        );

      allow read: if hasAdminPermission('sampleForms', 'view')
        || ownsByUidOrEmail(resource.data.uploadedByUid, resource.data.uploadedBy);

      allow update: if hasAdminPermission('sampleForms', 'edit')
        || ownsByUidOrEmail(resource.data.uploadedByUid, resource.data.uploadedBy);
      allow delete: if hasAdminPermission('sampleForms', 'delete')
        || ownsByUidOrEmail(resource.data.uploadedByUid, resource.data.uploadedBy);
    }

    match /clientNotifications/{notificationId} {
      allow create: if hasAnyAdminPermission();

      allow read: if hasAnyAdminPermission()
        || ownsByUidOrEmail(resource.data.recipientUid, resource.data.recipientEmail);

      allow update: if hasAnyAdminPermission()
        || ownsByUidOrEmail(resource.data.recipientUid, resource.data.recipientEmail);
      allow delete: if hasAnyAdminPermission()
        || ownsByUidOrEmail(resource.data.recipientUid, resource.data.recipientEmail);
    }

    match /chargeSlips/{chargeSlipId} {
      allow create: if isSignedIn()
        && isClientOrAdmin()
        && (
          (hasAdminPermission('chargeSlips', 'create') && request.resource.data.uuid is string)
          || hasOwnedUuid(request.resource.data.uuid)
        );

      allow read: if hasAdminPermission('chargeSlips', 'view')
        || canAccessLinkedInquiryDoc(resource.data.inquiryId, resource.data.uuid, resource.data.email);

      allow update: if isSignedIn()
        && isClientOrAdmin()
        && (
          hasAdminPermission('chargeSlips', 'edit')
          || (
            hasOwnedUuid(resource.data.uuid)
            && hasOwnedUuid(request.resource.data.uuid)
            && request.resource.data.uuid == resource.data.uuid
          )
        );
      allow delete: if hasAdminPermission('chargeSlips', 'delete')
        || hasOwnedUuid(resource.data.uuid);
    }

    match /receipts/{receiptId} {
      allow create: if isSignedIn()
        && request.resource.data.uploadedBy == userEmail();

      allow read: if isSignedIn();

      allow update: if hasAdminPermission('chargeSlips', 'edit')
        || resource.data.uploadedBy == userEmail();
      allow delete: if hasAdminPermission('chargeSlips', 'delete')
        || resource.data.uploadedBy == userEmail();
    }

    match /adminChannels/{channelId} {
      allow read: if hasAnyAdminPermission();
      allow create: if hasAnyAdminPermission();
      allow update: if hasAnyAdminPermission();
      allow delete: if hasAnyAdminPermission();
    }

    match /adminMessages/{messageId} {
      allow read: if hasAnyAdminPermission();
      allow create: if hasAnyAdminPermission();
      allow update: if hasAnyAdminPermission();
      allow delete: if hasAnyAdminPermission();
    }

    match /presence/{presenceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /clientConformes/{conformeId} {
      allow create: if isSignedIn()
        && request.resource.data.data.createdBy == userEmail()
        && (
          !('createdByUid' in request.resource.data.data)
          || request.resource.data.data.createdByUid == userUid()
        );

      allow read: if hasAdminPermission('memberApprovals', 'view')
        || ownsByUidOrEmail(resource.data.data.createdByUid, resource.data.data.createdBy);

      allow update: if hasAdminPermission('memberApprovals', 'edit');
      allow delete: if false;
    }

    // ----- Default deny -----

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
